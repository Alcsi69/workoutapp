{
  "name": "workoutapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "^58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "metro": "^0.82.5",
    "metro-cache": "^0.82.5",
    "metro-cache-key": "^0.82.5",
    "metro-transform-worker": "^0.82.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify:db": "rm -rf .verify-build && tsc -p scripts/tsconfig.verify.json && node scripts/verify-db.cjs",
    "verify:server": "rm -rf .verify-build server/dist && tsc -p scripts/tsconfig.verify.json && tsc -p server/tsconfig.json && node scripts/verify-server.cjs",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node server/dist/server/src/index.js",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "private": true
}
